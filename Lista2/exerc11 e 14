#include <iostream>
using namespace std;

int main()
{
    int i;
    float a,b,c,temp;

    cin>>i>>a>>b>>c;

    if(a>b){ temp=a; a=b; b=temp; }
    if(a>c){ temp=a; a=c; c=temp; }
    if(b>c){ temp=b; b=c; c=temp; }

    if(i==1)
        cout<<a<<" "<<b<<" "<<c;
    else if(i==2)
        cout<<c<<" "<<b<<" "<<a;
    else if(i==3)
        cout<<a<<" "<<c<<" "<<b;

    return 0;
}
