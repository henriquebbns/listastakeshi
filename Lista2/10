#include <iostream>
using namespace std;

int main()
{
    float saldo, credito;

    cin>>saldo;

    if(saldo<=200)
        credito = 0;
    else if(saldo<=400)
        credito = saldo*0.2;
    else if(saldo<=600)
        credito = saldo*0.3;
    else
        credito = saldo*0.4;

    cout<<"Credito: "<<credito;

    return 0;
}
