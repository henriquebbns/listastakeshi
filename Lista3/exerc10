#include <iostream>
#include <math.h>

using namespace std;

int main(int argc, char** argv) 
{
    int n;
    int a = 0, b = 1, c;
    int i = 3;

    cout<<"Digite um termo (>2): ";
    cin>>n;

    // consistência
    if(n <= 2)
    {
        cout<<"Numero invalido";
    }
    else
    {
        cout<<a<<" "<<b<<" ";

        while(i <= n)
        {
            c = a + b;
            cout<<c<<" ";

            a = b;
            b = c;

            i=i+1;
        }
    }

    return 0;
}
